# betb2b — example configuration. Copy to `.env` in this folder and fill in:
#
#     cp src/sites/betb2b/.env.example src/sites/betb2b/.env
#
# `.env` is gitignored: never commit it or paste its values anywhere.
# The CLI loads `src/sites/betb2b/.env` (and a repo-root `.env`) automatically;
# real environment variables always win over the file. Set BETB2B_NO_DOTENV=1
# to skip loading it. Everything below is optional — with no `.env` at all the
# scraper saves to a local SQLite file and uses the built-in defaults.

# ============ Remote store (any Postgres: Neon, a VPS, self-hosted…) ============
# Leave unset to work purely locally. A bare "postgresql://…" URL is fine — it is
# rewritten to the psycopg driver automatically. Copy the string from your
# provider's dashboard ("Connect"); keep ?sslmode=require if it has it.
# DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require

# How the store is chosen:
#   auto   = DATABASE_URL set -> remote, else local SQLite            (default)
#   mirror = write locally AND replay to the remote (safe if it is unreachable)
#   remote = remote only; fail fast without DATABASE_URL
#   local  = ignore DATABASE_URL, local SQLite only
BETB2B_STORE_MODE=auto

# Local SQLite file (the default store; also the local copy in mirror mode)
BETB2B_DB_PATH=data/betb2b/odds.db

# Storage-quota monitor: size limit of the HOSTED database in MB (e.g. 1000 for a
# 1 GB free plan). Used to warn/prune before a provider restricts the project.
BETB2B_DB_LIMIT_MB=1000

# ============ CLI defaults (used when the flag is omitted) ============
# Skins: linebet, 22bet, betwinner, melbet, megapari, 888starz, helabet, paripesa
# (all share one odds feed; which one answers best depends on your network)
BETB2B_SKIN=betwinner
# Sport slug: basketball, football, ice-hockey, tennis, esports (empty = all sports)
BETB2B_SPORT=basketball
# live | scheduled | all   (or list_live / list_prematch / list_all)
BETB2B_ACTION=scheduled
BETB2B_COUNT=50
BETB2B_TIMEOUT=300
BETB2B_RATE=30

# ============ Resilience (direct mode) ============
# Parallel match fetches. Lower = gentler on the sites' rate limits.
BETB2B_CONCURRENCY=4
# Requests per SECOND to one skin, across all workers. Concurrency alone still sends ~20/s on a
# fast site, which the sites answer by dropping your address for a while. 0 = unlimited.
BETB2B_MAX_RPS=3
# A failed fetch (timeout / block) is retried this many times, doubling the wait
# (seconds) each time.
BETB2B_RETRIES=2
BETB2B_RETRY_BACKOFF=2
# Ids that still fail are retried on these skins, in order (same feed, other brand).
BETB2B_FALLBACK_SKINS=melbet,22bet,linebet
# A skin that gives no answer at all (timeouts / dropped connections) this many times in a
# row is left alone for FAIL_COOLDOWN seconds (doubling on each further streak), by every
# part of the scraper at once. Any answer resets the count.
BETB2B_FAIL_THRESHOLD=6
BETB2B_FAIL_COOLDOWN=300
# Optional request budget per skin per hour (0 = unlimited). A first full scrape of one
# sport is a few hundred requests; 1500 leaves room for retries.
BETB2B_HOURLY_BUDGET=0

# ============ Optional: push predictions to the scorewise engine (--ingest) ============
# SCOREWISE_ENGINE_URL=
# SCOREWISE_API_KEY=

# ============ Optional: read-only REST access to the same database (Neon Data API) ============
# The URL is not secret; the token is. The scraper itself does not use these.
# NEON_DATA_API_URL=
# NEON_DATA_API_TOKEN=

# ============ Optional: proxy ============
# For getting past the WEBSITE (the browser path) only — never for API/feed calls.
# Leave these commented out unless your IP is blocked at the site itself.
# BETB2B_PROXY_URL=http://USER:PASSWORD@HOST:PORT
# BETB2B_PROXY_USER=
# BETB2B_PROXY_PASS=
# BETB2B_PROXY_COUNTRY=

# ============ Optional: browser profiles + block handling ============
# The browser bootstrap reuses a persistent Chromium profile per skin, so a passed
# browser-validation survives between runs. "off" = fresh throwaway browser every run.
# BETB2B_PROFILE=off                         # default: a profile named betb2b-<skin>
# SCRAPAMOJA_PROFILE_DIR=~/.scrapamoja/profiles
# Where per-site block state (cooldowns, escalation tier) is kept:
# SCRAPAMOJA_SECURITY_DIR=~/.scrapamoja/security
# Allow asking a person to pass a check in a headed window (default: only when a terminal is attached):
# SCRAPAMOJA_INTERACTIVE=1
